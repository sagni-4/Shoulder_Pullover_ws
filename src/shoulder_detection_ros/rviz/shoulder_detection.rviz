Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Camera (raw)
      Topic:
        Value: /sensing/camera/CAM_FRONT/image_raw
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Shoulder overlay
      Topic:
        Value: /shoulder_detection_node/overlay_image
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Shoulder-only overlay
      Topic:
        Value: /shoulder_detection_node/shoulder_only_overlay_image
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Class mask (raw indices 0/1/2)
      Topic:
        Value: /shoulder_detection_node/class_mask
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Value: false
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Centerline debug (painted points + fit)
      Topic:
        Value: /shoulder_centerline_node/centerline_debug_image
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Name: Current View
      Target Frame: base_link
    Saved: ~
Window Geometry:
  Camera (raw):
    collapsed: false
  Height: 900
  Shoulder overlay:
    collapsed: false
  Width: 1200
  X: 60
  Y: 60

<launch>
  <!--
    Reloads planning_validator into its existing, already-running component
    container with ONLY its trajectory input remapped to
    pullover_trajectory_gate's output; everything else (all other remaps,
    all param files, vehicle_info) is copied byte-for-byte from
    autoware_planning_validator/launch/planning_validator.launch.xml so this
    is a like-for-like swap, not a fresh reconfiguration.

    Procedure (see project memory, pullover_mrm_framework.md, "Live vehicle
    control wiring" section, for the full story of why this exists and the
    exact live debugging that produced it):
      1. Start pullover_trajectory_gate_node FIRST (it must already be
         publishing /planning/trajectory_gate/output, even in pure
         pass-through mode, before planning_validator's subscription can
         connect to anything).
      2. Find planning_validator's current component ID:
           ros2 component list
         (look under /planning/planning_validator_container)
      3. Unload it:
           ros2 component unload /planning/planning_validator_container <ID>
      4. Immediately reload it via this file:
           ros2 launch autoware_shoulder_pullover_manager reload_planning_validator_via_gate.launch.xml
      5. Verify: `ros2 node list | grep planning_validator` should show
         exactly `/planning/planning_validator` (NOT `/planning_validator`
         with no namespace; that happened once and indicates the
         namespace attribute below got dropped/ignored, which can confuse
         Autoware's own diagnostics even though data flow is unaffected).
         `ros2 topic hz /planning/trajectory` should resume at its normal
         rate.

    This has to be redone (steps 2-4) every time the underlying Autoware
    launch stack is restarted; it is NOT persisted anywhere in the normal
    launch tree, deliberately, since editing autoware_launch's own files
    was considered more invasive than this live reload.
  -->
  <let name="common_config_path" value="$(find-pkg-share autoware_launch)/config/planning/scenario_planning/common"/>

  <load_composable_node target="/planning/planning_validator_container">
    <composable_node pkg="autoware_planning_validator" plugin="autoware::planning_validator::PlanningValidatorNode" name="planning_validator" namespace="/planning">
      <remap from="~/input/objects" to="/perception/object_recognition/objects"/>
      <remap from="~/input/pointcloud" to="/perception/obstacle_segmentation/pointcloud"/>
      <remap from="~/input/trajectory" to="/planning/trajectory_gate/output"/>
      <remap from="~/input/traffic_signals" to="/perception/traffic_light_recognition/traffic_signals"/>
      <remap from="~/input/lanelet_map_bin" to="/map/vector_map"/>
      <remap from="~/input/route" to="/planning/mission_planning/route"/>
      <remap from="~/input/kinematics" to="/localization/kinematic_state"/>
      <remap from="~/input/acceleration" to="/localization/acceleration"/>
      <remap from="~/input/operational_mode_state" to="/system/operation_mode/state"/>
      <remap from="~/output/trajectory" to="/planning/trajectory"/>
      <remap from="~/output/validation_status" to="~/validation_status"/>
      <!-- e2e_simulator.launch.xml threads use_sim_time:=true as an explicit arg down
           through the whole stock launch tree; a composable node reloaded here from a
           separate ros2 launch invocation does not inherit it and silently defaults to
           wall-clock time, which made LatencyChecker compare a sim-time trajectory stamp
           against a wall-clock now() and fail every single cycle (found live 2026-08-13). -->
      <param name="use_sim_time" value="true"/>
      <param name="launch_modules" value="[autoware::planning_validator::LatencyChecker, autoware::planning_validator::TrajectoryChecker, autoware::planning_validator::IntersectionCollisionChecker, autoware::planning_validator::RearCollisionChecker, ]"/>
      <param from="$(var common_config_path)/planning_validator/planning_validator.param.yaml"/>
      <param from="$(var common_config_path)/planning_validator/latency_checker.param.yaml"/>
      <param from="$(var common_config_path)/planning_validator/trajectory_checker.param.yaml"/>
      <param from="$(var common_config_path)/planning_validator/intersection_collision_checker.param.yaml"/>
      <param from="$(var common_config_path)/planning_validator/rear_collision_checker.param.yaml"/>
      <param from="$(find-pkg-share sample_vehicle_description)/config/vehicle_info.param.yaml"/>
      <extra_arg name="use_intra_process_comms" value="false"/>
    </composable_node>
  </load_composable_node>
</launch>
